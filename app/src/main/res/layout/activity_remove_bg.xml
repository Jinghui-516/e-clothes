<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="16dp"
    android:background="@color/brand_background">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="AI 去背小助手"
        android:textColor="#556A7F"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="20dp"/>

    <FrameLayout
        android:layout_width="300dp"
        android:layout_height="300dp"
        android:background="@drawable/corners_login"
        android:padding="10dp">

        <ImageView
            android:id="@+id/iv_preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter" />

        <ProgressBar
            android:id="@+id/progress_bar"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_gravity="center"
            android:visibility="gone" />
    </FrameLayout>

    <Space android:layout_width="match_parent" android:layout_height="30dp"/>

    <Button
        android:id="@+id/btn_select_image"
        android:layout_width="250dp"
        android:layout_height="50dp"
        android:text="從相簿選擇圖片"
        android:backgroundTint="@color/brand_primary"
        android:textColor="@color/white" />

    <Button
        android:id="@+id/btn_remove_bg"
        android:layout_width="250dp"
        android:layout_height="50dp"
        android:layout_marginTop="12dp"
        android:text="開始 AI 去背"
        android:visibility="gone"
        android:backgroundTint="#FFB74D"
        android:textColor="@color/white" />

    <Button
        android:id="@+id/btn_save_image"
        android:layout_width="250dp"
        android:layout_height="50dp"
        android:layout_marginTop="12dp"
        android:text="儲存去背照片到相簿"
        android:visibility="gone"
        android:backgroundTint="#81C784"
        android:textColor="@color/white" />

</LinearLayout>