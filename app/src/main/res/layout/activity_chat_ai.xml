<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <RelativeLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/brand_primary"
        android:paddingHorizontal="16dp">

        <ImageButton
            android:id="@+id/btn_chat_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/previous"
            app:tint="@color/white" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="e-fit 穿搭小助手"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_chat"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/top_bar"
        android:layout_above="@id/styleButtonScroll"
        android:padding="16dp"
        android:clipToPadding="false"/>

    <HorizontalScrollView
        android:id="@+id/styleButtonScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@id/inputLayout"
        android:scrollbars="none"
        android:background="#FDFBF9"
        android:paddingVertical="10dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <Button android:id="@+id/btn_handsome" android:layout_width="wrap_content" android:layout_height="40dp" android:text="😎 帥氣" android:background="@drawable/bg_style_button" android:layout_marginEnd="8dp" android:textAllCaps="false" android:textColor="#4A3E3D" />
            <Button android:id="@+id/btn_cute" android:layout_width="wrap_content" android:layout_height="40dp" android:text="🎀 甜美" android:background="@drawable/bg_style_button" android:layout_marginEnd="8dp" android:textAllCaps="false" android:textColor="#4A3E3D" />
            <Button android:id="@+id/btn_daily" android:layout_width="wrap_content" android:layout_height="40dp" android:text="☕ 韓系" android:background="@drawable/bg_style_button" android:layout_marginEnd="8dp" android:textAllCaps="false" android:textColor="#4A3E3D" />
            <Button android:id="@+id/btn_retro" android:layout_width="wrap_content" android:layout_height="40dp" android:text="🎞️ 復古" android:background="@drawable/bg_style_button" android:layout_marginEnd="8dp" android:textAllCaps="false" android:textColor="#4A3E3D" />
            <Button android:id="@+id/btn_sporty" android:layout_width="wrap_content" android:layout_height="40dp" android:text="👟 運動" android:background="@drawable/bg_style_button" android:layout_marginEnd="8dp" android:textAllCaps="false" android:textColor="#4A3E3D" />
            <Button android:id="@+id/btn_minimalist" android:layout_width="wrap_content" android:layout_height="40dp" android:text="⚖️ 極簡" android:background="@drawable/bg_style_button" android:layout_marginEnd="8dp" android:textAllCaps="false" android:textColor="#4A3E3D" />
            <Button android:id="@+id/btn_boho" android:layout_width="wrap_content" android:layout_height="40dp" android:text="🌵 波西" android:background="@drawable/bg_style_button" android:layout_marginEnd="8dp" android:textAllCaps="false" android:textColor="#4A3E3D" />
            <Button android:id="@+id/btn_street" android:layout_width="wrap_content" android:layout_height="40dp" android:text=" skate 街頭" android:background="@drawable/bg_style_button" android:layout_marginEnd="8dp" android:textAllCaps="false" android:textColor="#4A3E3D" />
            <Button android:id="@+id/btn_y2k" android:layout_width="wrap_content" android:layout_height="40dp" android:text="💿 Y2K" android:background="@drawable/bg_style_button" android:textAllCaps="false" android:textColor="#4A3E3D" />
        </LinearLayout>
    </HorizontalScrollView>

    <LinearLayout
        android:id="@+id/inputLayout"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal"
        android:padding="8dp"
        android:gravity="center_vertical"
        android:background="#FFFFFF">

        <EditText
            android:id="@+id/et_message_input"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:hint="輸入訊息..."
            android:background="@drawable/bg_input_box"
            android:paddingHorizontal="12dp" />

        <ImageView
            android:id="@+id/btn_send"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_send"
            android:layout_marginStart="8dp"
            android:clickable="true"
            android:focusable="true"/>
    </LinearLayout>

</RelativeLayout>