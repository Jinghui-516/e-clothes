<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand_background"
    tools:context=".clothes.Wardrobe">

    <LinearLayout
        android:id="@+id/header_layout"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_alignParentTop="true"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp">

        <ImageView
            android:id="@+id/imageView2"
            android:layout_width="120dp"
            android:layout_height="40dp"
            android:src="@drawable/logo_login"
            android:scaleType="fitStart" />

        <Space
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/menu_friend"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/menu"
            app:tint="@color/brand_primary" />
    </LinearLayout>

    <View
        android:id="@+id/header_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_below="@id/header_layout"
        android:background="@color/brand_primary" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/header_divider"
        android:layout_above="@id/bottom_navigation"
        android:paddingHorizontal="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <!-- 標題區塊 -->
            <LinearLayout
                android:id="@+id/layout_title_selector"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingEnd="16dp">

                <TextView
                    android:id="@+id/tv_main_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="我的衣櫃"
                    android:textColor="@color/brand_primary"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="8dp"
                    android:src="@android:drawable/arrow_down_float"
                    app:tint="@color/brand_primary" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp"
                android:text="要記得定期整理唷！"
                android:textColor="@color/brand_secondary"
                android:textSize="14sp" />

            <!-- 🌟 顏色過濾列 (懸浮按鈕風格) -->
            <HorizontalScrollView
                android:id="@+id/hsv_color_filter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:clipToPadding="false"
                android:paddingBottom="12dp"
                android:layout_marginBottom="8dp">

                <LinearLayout
                    android:id="@+id/layout_color_filters"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingHorizontal="4dp" />
            </HorizontalScrollView>

            <!-- ========================================== -->
            <!-- 📦 顏色篩選結果網格 (預設隱藏) -->
            <!-- ========================================== -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_color_filtered_grid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:visibility="gone" />

            <!-- ========================================== -->
            <!-- 📦 我的衣櫃內容 (預設顯示的所有分類) -->
            <!-- ========================================== -->
            <LinearLayout
                android:id="@+id/layout_wardrobe_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView android:id="@+id/hat_txv" style="@style/WardrobeLabel" android:text="頭飾" />
                <LinearLayout android:id="@+id/hat_layout" style="@style/WardrobeRow">
                    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="none">
                        <LinearLayout android:id="@+id/imagesContainer" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" />
                    </HorizontalScrollView>
                </LinearLayout>

                <TextView android:id="@+id/dress_txv" style="@style/WardrobeLabel" android:text="洋裝" />
                <LinearLayout android:id="@+id/dress_layout" style="@style/WardrobeRow">
                    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="none">
                        <LinearLayout android:id="@+id/dressimagesContainer" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" />
                    </HorizontalScrollView>
                </LinearLayout>

                <TextView android:id="@+id/clothes_txv" style="@style/WardrobeLabel" android:text="上衣" />
                <LinearLayout android:id="@+id/clothes_layout" style="@style/WardrobeRow">
                    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="none">
                        <LinearLayout android:id="@+id/clothesimagesContainer" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" />
                    </HorizontalScrollView>
                </LinearLayout>

                <TextView android:id="@+id/pants_txv" style="@style/WardrobeLabel" android:text="褲子" />
                <LinearLayout android:id="@+id/pants_layout" style="@style/WardrobeRow">
                    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="none">
                        <LinearLayout android:id="@+id/pantsimagesContainer" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" />
                    </HorizontalScrollView>
                </LinearLayout>

                <TextView android:id="@+id/skirt_txv" style="@style/WardrobeLabel" android:text="裙子" />
                <LinearLayout android:id="@+id/skirt_layout" style="@style/WardrobeRow">
                    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="none">
                        <LinearLayout android:id="@+id/skirtimagesContainer" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" />
                    </HorizontalScrollView>
                </LinearLayout>

                <TextView android:id="@+id/shoes_txv" style="@style/WardrobeLabel" android:text="鞋子" />
                <LinearLayout android:id="@+id/shoes_layout" style="@style/WardrobeRow">
                    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="none">
                        <LinearLayout android:id="@+id/shoesimagesContainer" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" />
                    </HorizontalScrollView>
                </LinearLayout>
            </LinearLayout>

            <!-- ========================================== -->
            <!-- 📦 我的搭配內容 (預設隱藏) -->
            <!-- ========================================== -->
            <LinearLayout
                android:id="@+id/layout_outfits_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_outfits_grid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:nestedScrollingEnabled="false" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_alignParentBottom="true"
        android:background="@color/brand_primary"
        app:itemIconTint="@color/white"
        app:itemIconSize="28dp"
        app:labelVisibilityMode="unlabeled"
        app:menu="@menu/bottom_nav_menu" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_add_clothes"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@id/fab_ai_robot"
        android:layout_alignParentEnd="true"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="12dp"
        android:src="@android:drawable/ic_input_add"
        app:tint="@color/white"
        app:backgroundTint="#8D7B68"
        app:elevation="6dp"
        app:fabSize="normal"
        android:contentDescription="新增衣服" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_ai_robot"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@id/bottom_navigation"
        android:layout_alignParentEnd="true"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="20dp"
        android:src="@drawable/ic_robot_head"
        app:tint="@color/white"
        app:backgroundTint="@color/brand_primary"
        app:elevation="6dp"
        app:fabSize="normal"
        android:contentDescription="AI 穿搭助手" />

</RelativeLayout>